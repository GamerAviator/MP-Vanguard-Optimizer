{
  "manifest_version": 3,
  "name": "Gamer Aviator's Vanguard Capture",
  "version": "1.0.3",
  "description": "Capture and review Vanguard levels from game responses. Local-only; no cloud account.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://mighty-party.com/*",
    "https://*.mighty-party.com/*",
    "https://*.blitzmightyparty.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/vanguard-16.png",
      "32": "icons/vanguard-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mighty-party.com/*",
        "https://*.mighty-party.com/*",
        "https://*.blitzmightyparty.com/*"
      ],
      "js": [
        "msgpack.js",
        "capture.js",
        "cache-reader.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mighty-party.com/*",
        "https://*.mighty-party.com/*",
        "https://*.blitzmightyparty.com/*"
      ],
      "js": [
        "names.js",
        "unit-map.js",
        "extract.js",
        "bridge.js",
        "auto-play.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/vanguard-16.png",
    "32": "icons/vanguard-32.png",
    "48": "icons/vanguard-48.png",
    "128": "icons/vanguard-128.png"
  },
  "version_name": "1.0.3"
}
